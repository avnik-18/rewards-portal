# Copy to .env.local and adjust — plain-Vite env vars are read via import.meta.env.VITE_*.
# Base URL of the public recognition site the offsite LinkedIn share points at.
VITE_RECOGNITION_BASE_URL=https://recognition.company.com

# Base URL of the recog-api FastAPI backend (uvicorn), no trailing slash.
# Backend runs `ENVIRONMENT=local` with CORS_ORIGINS allowing this dev origin.
VITE_API_BASE_URL=http://localhost:8000

# The demo employee code sent as X-Demo-User — backend local-mode identity
# impersonation only. Leave unset never to send the header.
VITE_DEMO_USER=E-RH
