# Copy to .env.local and adjust — plain-Vite env vars are read via import.meta.env.VITE_*.
# Base URL of the public recognition site the offsite LinkedIn share points at.
VITE_RECOGNITION_BASE_URL=https://recognition.company.com

# Rewards backend mount point — full URL INCLUDING the /api/v1 prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Dev-only identity: backend's local X-Demo-User header value (never a prod build).
VITE_DEMO_USER=E-PR
