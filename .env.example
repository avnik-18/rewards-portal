# Copy to .env and fill real values. Never commit the real .env.
#
# IDENTITY IS FAIL-CLOSED (reviewer auth comment):
#   ENVIRONMENT must be set explicitly. unset/blank → the app refuses to start.
#   local        → the X-Demo-User dev identity is available in Swagger/Postman.
#   production   → ENTRA_* values below are REQUIRED at start-up; a deployed
#                  app without real SSO can no longer fall back to open
#                                  impersonation.

ENVIRONMENT=local           # local | production — must be explicit
LOG_LEVEL=INFO

# REQUIRED — no default: the app refuses to start without it
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recog

# OpenTelemetry — leave empty to disable tracing locally
OTLP_ENDPOINT=

# CORS allowlist (comma-separated browser origins); empty disables CORS.
CORS_ORIGINS=

# Trusted hosts (Host-header validation), comma-separated. "*" is local-only:
# a non-local boot with an empty or wildcard list refuses to start. Outside
# local this is REQUIRED.
ALLOWED_HOSTS=www.rewards.example.com

# Microsoft Entra ID SSO — REQUIRED whenever ENVIRONMENT != local.
# App registration: Tenant ID, Client ID (audience), Client Secret (secret),
# Authority = https://login.microsoftonline.com/<TENANT_ID>
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=

# Outlook email via Microsoft Graph (app-only Mail.Send on the noreply mailbox).
# GRAPH_MAILBOX empty → LogEmailSender (emails are written to logs, useful locally).
# Outside local the full GRAPH_* set is REQUIRED at start-up (fail-closed:
# the app refuses to boot when every notification would fail at send time).
GRAPH_MAILBOX=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
